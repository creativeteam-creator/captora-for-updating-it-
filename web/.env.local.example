# Captora env config — copy to `.env.local` and fill what you need.

# ─── Supabase (auth + database + storage) ────────────────────────────────
# Get these from your Supabase project:
#   Dashboard → Settings → API → Project URL + anon/public + service_role
# URL format is `https://<project-ref>.supabase.co` — NOT the dashboard URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS. Treat like a password. Never commit, never
# expose to the browser. Used by background workers / admin tasks only.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Transcription router ────────────────────────────────────────────────
# All keys below are OPTIONAL. Without any, Captora falls back to local
# CPU Whisper.
#
# Routing priority (highest first):
#   1. Local GPU via faster-whisper (if FASTER_WHISPER_ENABLED)
#   2. Sarvam (Indic languages, if SARVAM_API_KEY)
#   3. Groq (non-Indic / fallback, if GROQ_API_KEY)
#   4. Local CPU Whisper (always available)

# Local GPU (faster-whisper). Install once: `pip install faster-whisper`
# FASTER_WHISPER_ENABLED=1
# FASTER_WHISPER_PYTHON=python              # full path if not on PATH
# FASTER_WHISPER_MODEL=large-v3
# FASTER_WHISPER_DEVICE=cuda
# FASTER_WHISPER_COMPUTE_TYPE=float16
# FASTER_WHISPER_INITIAL_PROMPT=QHT Clinic, Haridwar, hair transplant, treatment
# CAPTORA_TRANSCRIPT_GLOSSARY=qhd=QHT,klinik=Clinic,haridur=Haridwar,trasplant=transplant,tritamen=treatment

# Cloud: Sarvam AI Saaras (Indic) — https://dashboard.sarvam.ai
# SARVAM_API_KEY=

# Cloud: Groq Whisper (non-Indic) — https://console.groq.com/keys
# GROQ_API_KEY=
