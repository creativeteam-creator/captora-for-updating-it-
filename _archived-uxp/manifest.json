{
  "manifestVersion": 5,
  "id": "com.qhtclinic.kalakar.autocaptions",
  "name": "Kalakar Auto Captions",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "kalakar.captions.panel",
      "label": {
        "default": "Kalakar Captions"
      },
      "minimumSize": { "width": 320, "height": 480 },
      "maximumSize": { "width": 1200, "height": 2000 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 420, "height": 720 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.openai.com",
        "https://*.n8n.cloud",
        "https://webhook.site",
        "http://localhost:3000"
      ]
    },
    "localFileSystem": "request"
  }
}
