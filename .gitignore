# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
dist/
build/
.turbo/

# Electron build outputs (large — DMG/EXE installers, never commit these)
dist-electron/
electron/dist/

# Workspace nested lockfiles — npm workspaces only need ONE root lockfile;
# nested ones confuse `npm ci --workspaces` in CI.
electron/package-lock.json
web/package-lock.json
remotion/package-lock.json

# Python virtual env (if user has one for the GPU scripts)
.venv/
__pycache__/

# Glossary cache file (per-machine state, not source-of-truth)
glossary.json

# Remotion
remotion/out/
remotion/.cache/
remotion/build/

# Environment
.env
.env.local
.env.production
.env.*.local
web/.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Tooling caches
.eslintcache
*.tsbuildinfo

# Generated media (tests, dev outputs)
tmp/
temp/
output/
